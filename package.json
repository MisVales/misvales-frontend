{
  "name": "misvales-frontend",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve --configuration development",
    "start:production": "ng serve --configuration production",
    "dev": "ng serve",
    "build": "ng build --configuration development",
    "build:test": "ng build --configuration test",
    "build:production": "ng build --configuration production",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "audit:release": "node scripts/release-audit.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "artifact:hash": "node scripts/hash-artifact.mjs",
    "e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run audit:release && npm run test:coverage && npm run build:production && npm run e2e",
    "check": "npm run verify"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/animations": "22.1.0",
    "@angular/cdk": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/material": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/router": "22.1.0",
    "decimal.js": "10.6.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.2",
    "@angular/cli": "22.1.2",
    "@angular/compiler-cli": "22.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "28.0.0",
    "postcss": "8.5.21",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.10"
  }
}
