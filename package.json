{
  "name": "misvales-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others --names NO-VPN,VPN \"npm run start:local\" \"npm run start:vpn\"",
    "start:local": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "start:vpn": "ng serve --host 0.0.0.0 --port 4201 --proxy-config proxy.vpn.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ng-select/ng-select": "^23.7.0",
    "@ngrx/signals": "^21.1.1",
    "@simplewebauthn/browser": "^13.3.0",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.11",
    "lottie-web": "^5.13.0",
    "lucide-angular": "^1.0.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.5.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/leaflet": "^1.9.22",
    "@types/luxon": "^3.7.3",
    "@types/qrcode": "^1.5.6",
    "@vitest/browser-playwright": "^4.1.10",
    "concurrently": "^10.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
